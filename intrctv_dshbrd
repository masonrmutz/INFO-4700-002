app_ui = ui.page_fluid(
    ui.h2("🏈 ESPN NFL Player Stats Dashboard"),

    ui.layout_sidebar(
        ui.sidebar(
            ui.input_select("stat_type", "Select Stat Type:", ["QB Passing", "RB Rushing", "WR Receiving"]),
            ui.input_select("team_select", "Filter by Team:", TEAMS),
            ui.input_text("player_search", "Search Player:"),
            ui.input_select("player1", "Compare Player 1:", []),
            ui.input_select("player2", "Compare Player 2:", []),
            ui.input_action_button("refresh", "🔄 Refresh Data")
        ),
        ui.navset_tab(
            ui.nav("Data Table", ui.output_data_frame("player_table")),
            ui.nav("Interactive Chart", ui.output_plot("chart")),
            ui.nav("Player Comparison", ui.output_ui("comparison_ui"))
        )
    )
)

def server(input, output, session):

    # Load and update data
    @reactive.Calc
    @reactive.event(input.refresh, input.stat_type)
    def df_raw():
        stype = input.stat_type()
        if stype == "QB Passing":
            return scrape_espn_passing_with_selenium()
        elif stype == "RB Rushing":
            return scrape_espn_rushing_with_selenium()
        else:
            return scrape_espn_receiving_with_selenium()

    @reactive.effect
    def _populate_players():
        df = df_raw()
        ui.update_select("player1", choices=sorted(df["Name"].dropna().unique()))
        ui.update_select("player2", choices=sorted(df["Name"].dropna().unique()))

    @reactive.Calc
    def df_filtered():
        df = df_raw().copy()
        if input.team_select() != "All":
            df = df[df["Team"] == input.team_select()]
        if input.player_search():
            df = df[df["Name"].str.contains(input.player_search(), case=False)]
        return df

    @output
    @render.data_frame
    def player_table():
        return render.DataTable(df_filtered(), filters=True, selection_mode="rows")

    @output
    @render.plot
    def chart():
        df = df_filtered()
        if input.stat_type() == "QB Passing":
            stat_x, stat_y = "YDS", "TD"
        elif input.stat_type() == "RB Rushing":
            stat_x, stat_y = "YDS", "TD"
        else:
            stat_x, stat_y = "YDS", "REC"
        chart = (
            alt.Chart(df)
            .mark_circle(size=80, opacity=0.7)
            .encode(
                x=alt.X(stat_x, title=stat_x),
                y=alt.Y(stat_y, title=stat_y),
                color="Team:N",
                tooltip=["Name", "Team", stat_x, stat_y]
            )
            .interactive()
        )
        return chart

    @output
    @render.ui
    def comparison_ui():
        df = df_raw()
        if not input.player1() or not input.player2():
            return ui.p("Select two players to compare.")
        p1 = df[df["Name"] == input.player1()].iloc[0]
        p2 = df[df["Name"] == input.player2()].iloc[0]
        return ui.HTML(f"""
        <div style='padding:10px;'>
            <h4>Comparison: {p1['Name']} ({p1['Team']}) vs {p2['Name']} ({p2['Team']})</h4>
            <p><b>Yards:</b> {p1['YDS']} vs {p2['YDS']}<br>
            <b>TDs:</b> {p1['TD']} vs {p2['TD']}<br>
            <b>AVG / QBR:</b> {p1.get('AVG', p1.get('QBR',''))} vs {p2.get('AVG', p2.get('QBR',''))}</p>
        </div>
        """)

app = App(app_ui, server)
