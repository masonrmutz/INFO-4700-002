    r = requests.put(url, headers=headers, json=payload)
    if not r.ok:
        raise RuntimeError(f"Error uploading file: {r.status_code} {r.text}")

    data = r.json()
    html_url = data.get("content", {}).get("html_url", url)
    print(f"Uploaded to GitHub: {html_url}")

# actually upload
upload_csv_to_github("sleeper_league.csv")
